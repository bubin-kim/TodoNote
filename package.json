{
  "name": "todo-note",
  "version": "0.1.0",
  "description": "떠 있는 줄 노트 체크리스트 위젯",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . TodoNote --platform=darwin --arch=$(uname -m | sed s/x86_64/x64/) --out=dist --overwrite --icon=build/icon.icns --ignore=\"^/dist\" --prune=true"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.0.0"
  },
  "productName": "TodoNote"
}